{
  "name": "wallet-connect-buttons",
  "private": true,
  "description": "Wallet Connect buttons for React, Vue and plain JavaScript, with example apps and backends",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/react",
    "examples/vue",
    "examples/vanilla",
    "examples/backends/nodejs",
    "examples/mock-wallet-connect"
  ],
  "scripts": {
    "build": "npm run build -w packages/wallet-connect-button-react && npm run build -w packages/wallet-connect-button-vue && npm run build -w packages/wallet-connect-button-vanillajs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:react": "npm run dev -w examples/react",
    "dev:vue": "npm run dev -w examples/vue",
    "dev:vanilla": "npm run dev -w examples/vanilla",
    "backend:node": "npm start -w examples/backends/nodejs",
    "mock:wallet-connect": "npm start -w examples/mock-wallet-connect",
    "release": "scripts/release.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  },
  "type": "module"
}
