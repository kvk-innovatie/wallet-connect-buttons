{
  "name": "wallet-connect-buttons",
  "private": true,
  "description": "Wallet Connect buttons for React, Vue and plain JavaScript, with example apps and backends",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "examples/react",
    "examples/vue",
    "examples/backends/nodejs"
  ],
  "scripts": {
    "build": "npm run build --workspace packages/wallet-connect-button-react --workspace packages/wallet-connect-button-vue --workspace packages/wallet-connect-button-vanillajs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:react": "npm run dev --workspace examples/react",
    "dev:vue": "npm run dev --workspace examples/vue",
    "dev:vanilla": "npm run dev --workspace packages/wallet-connect-button-vanillajs",
    "backend:node": "npm start --workspace examples/backends/nodejs",
    "update-nl-wallet-web": "scripts/update-nl-wallet-web.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
