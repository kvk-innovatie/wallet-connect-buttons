{
  "name": "nb-wallet-connect-button-vanillajs",
  "version": "2.0.0",
  "description": "Web component for NB Wallet (ZZP Garantie app) wallet connect",
  "type": "module",
  "license": "MIT",
  "author": "Michiel Mayer",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/nb-wallet-connect-button-vanillajs/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/nb-wallet-connect-button-vanillajs/src/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./slim": {
      "types": "./dist/nb-wallet-connect-button-vanillajs/src/slim.d.ts",
      "import": "./dist/slim.js",
      "require": "./dist/slim.cjs"
    },
    "./style.css": "./dist/style.css",
    "./cdn": "./dist/nb-wallet-connect-button.js",
    "./cdn/slim": "./dist/nb-wallet-connect-button.slim.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "vite build && node ../../tooling/emit-types.mjs . && vite build --mode cdn && vite build --mode cdn-slim",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "web-component",
    "custom-element",
    "wallet",
    "wallet-connect",
    "eudi",
    "button"
  ],
  "peerDependencies": {},
  "devDependencies": {
    "@wallet-connect/core": "*",
    "@wallet-connect/ui-vanilla": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kvk-innovatie/wallet-connect-buttons.git",
    "directory": "packages/nb-wallet-connect-button-vanillajs"
  },
  "homepage": "https://github.com/kvk-innovatie/wallet-connect-buttons/tree/main/packages/nb-wallet-connect-button-vanillajs#readme",
  "bugs": "https://github.com/kvk-innovatie/wallet-connect-buttons/issues",
  "jsdelivr": "./dist/nb-wallet-connect-button.js",
  "unpkg": "./dist/nb-wallet-connect-button.js"
}
